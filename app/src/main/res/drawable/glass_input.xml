<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_fill" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="@color/glass_sheen" android:endColor="@color/glass_clear" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/glass_rim" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:left="12dp" android:right="12dp" android:top="0.5dp" android:height="1.5dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@color/glass_clear" android:centerColor="@color/glass_hi" android:endColor="@color/glass_clear" />
        </shape>
    </item>
</layer-list>
